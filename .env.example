# Copy to .env (gitignored) and fill in.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
# Pydantic AI model string. Default = Gemini Flash (free tier). Escalation tier = anthropic:claude-haiku-...
MODEL=google:gemini-2.5-flash
BUDGET_USD=5
# Shared secret required on /scan and /stats when set. Leave empty on localhost;
# set a long random value before exposing the server through a tunnel.
SCAN_TOKEN=

# Feature 002: second tier. Empty disables escalation. Needs ANTHROPIC_API_KEY.
ESCALATION_MODEL=anthropic:claude-haiku-4-5
# Escalate when the primary result's best object confidence is below this.
ESCALATE_BELOW=0.6

# Feature 007: optional tracing. Set a Logfire token (and `uv add logfire`) to see model calls as spans.
LOGFIRE_TOKEN=
